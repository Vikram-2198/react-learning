import { defineConfig } from "vite";
import react from "@vitejs/plugin-react";

export default defineConfig({
  plugins: [react()],

    server: {
    proxy: {
        "/wp-api": {
        target: "http://wordpress-react.test",
        changeOrigin: true,
        rewrite: (path) =>
            path.replace(/^\/wp-api/, "/wp-json/wp/v2"),
        },
    },
    },
});
